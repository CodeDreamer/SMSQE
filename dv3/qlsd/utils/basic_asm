;
; 2020-02-05  1.01  Added flash functions for QL-SD ROM (MK)

	section init

	include 'dev8_dv3_qlsd_keys'
	include 'dev8_keys_qdos_sms'
	include 'dev8_keys_qlv'
	include 'dev8_keys_sys'
	include 'dev8_keys_err'
	include 'dev8_mac_proc'
	include 'dev8_mac_text'
	include 'dev8_mac_assert'

	xdef	init

	xref	get_linkage

init
	suba.l	a0,a0
	lea	banner(pc),a1
	move.w	ut.wtext,a2
	jsr	(a2)

	bsr	get_linkage
	bne.s	init_err

	move.w	sb.inipr,a2

	move.b	if_base+if_version,d0
	andi.b	#if.ver_mask,d0
	cmp.b	#if.ver_v3_rom,d0
	bne.s	no_flash

	lea	flash_procs,a1
	jsr	(a2)
no_flash
	lea	card_procs,a1
	jmp	(a2)

init_err
	suba.l	a0,a0
	lea	txt_err(pc),a1
	move.w	ut.wtext,a2
	jsr	(a2)
	moveq	#err.nc,d0
	rts

card_procs
	proc_stt
	proc_def CARD_RENF
	proc_def CARD_CREATE
	proc_end
	proc_stt
	proc_def CARD_DIR$
	proc_end

flash_procs
	proc_stt
	proc_def ROM_FLASH
	proc_def ROM_READ
	proc_end
	proc_stt
	proc_def ROM_ID
	proc_def ROM_SELECTED
	proc_end

banner	mkstr	{QLSD utilities v1.02 WL + MK 2021\}
txt_err mkstr	{QLSD driver not found or too old\}

	end
