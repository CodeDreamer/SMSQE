; Driver definition block
ddb_ssio  equ	$28			; 6b  iou.ssio function block
ddb_sst   equ	$2e			; l   byte test
ddb_ssi   equ	$32			; l   byte fetch
ddb_sso   equ	$36			; l   byte send
ddb_rts   equ	$3a			; w   RTS
ddb_chips equ	$3c			; b   chip count
ddb_chipm equ	$3d			; b   mask of chips already open
;					  2b
ddb_cdb0  equ	$40			; l   pointer to cdb
ddb_cdb1  equ	$44			; l   pointer to cdb
ddb_qsnd  equ	$48			; l   QSound pointer
ddb_end   equ	$60

; This data starts at chn_end
chn_outq  equ	$18			; l   out-queue
chn_chipm equ	$1c			; b   mask of chips for channel
;					; b
chn_frame equ	$1e			; w   size of a single frame
chn_chip0 equ	$20			; 3b  chip numbers
;					; b   must be 0
chn_poll  equ	$24			; l   poll counter
chn_bsze  equ	$28			; l   buffer size
chn_slot  equ	$2c			; l   ptr to ddb_cdbx slot
chn.len   equ	$30
