6450 DEFine PROCedure wdel_f (source$,array_with_extns$)
6460 REMark Delete either all files on dir$, or only all files with any extension
6470 REMark contained in the array_with_extns$ string array. This does NOT recurse
6480 REMark into subdirs.
6490 LOCal lp%,iters%,chan%,myname$,a$,lp2%,dir$
6500   myname$="wdel_f" &RND(0 TO 100) &RND(0 TO 100) &RND(0 TO 100) &RND(0 TO 100) &RND(0 TO 100)
6510   chan%=FOP_OVER("ram1_"&myname$)
6520   IF chan%<0:RETurn             : REMark can't open channel, give up
6530   IF LEN(source$)>5
6540     dir$=source$(1 TO 5)
6550   ELSE
6560     dir$=source$
6570   END IF
6580   DIR#chan%,source$
6590   GET#chan%\0
6600   INPUT#chan%,a$
6610   INPUT#chan%,a$
6620   iters%=DIMN(array_with_extns$,1)
6630   IF iters%=0
6640                                     : REMark no extension - delete everything
6650     REPeat lp%
6660       IF EOF(#chan%):EXIT lp%
6670       INPUT#chan%,a$
6680       IF a$==myname$ OR a$="":NEXT lp%
6690       IF endswith% (" ->",a$): NEXT lp%: REMark don't go into subdirs
6700       DELETE dir$&a$
6710     END REPeat lp%
6720   ELSE
6730                                   : REMark only delete files with matching extension
6740     REPeat lp%
6750       IF EOF(#chan%):EXIT lp%
6760       INPUT#chan%,a$
6770       IF a$==myname$ OR a$="":NEXT lp%
6780       FOR lp2%=0 TO iters%
6790         IF endswith% (array_with_extns$(lp2%),a$)
6800           DELETE dir$&a$
6810           EXIT lp2%
6820         END IF
6830       END FOR lp2%
6840     END REPeat lp%
6850   END IF
6860   CLOSE#chan%
6870   DELETE "ram1_"&myname$
6880 END DEFine wdel_f
6890 :
6900 DEFine FuNction endswith%(extension$,name$)
6910 REMark checks whether name$ ends with extension$. Returns 1 if yes, 0 if not. If
6920 REMark either of the params is "", returns 0.
6930 LOCal elen%,nlen%
6940   IF extension$="" OR name$="":RETurn 0
6950   elen%=LEN(extension$)
6960   nlen%=LEN(name$)
6970   IF elen%>nlen%:RETurn 0
6980   IF name$(nlen%-elen%+1 TO)== extension$: RETurn 1
6990   RETurn 0
7000 END DEFine endswith%
