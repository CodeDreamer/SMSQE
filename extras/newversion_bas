4740 DEFine FuNction make_date$(dflag%,what_date)
4750 REMark returns date as "01.01.1991" (dflag%=1) or "1991.01.31" (dflag%=0)
4760 REMark if what_date<>0, then it is this date that will be returned
4770 REMark this presumes that a variable "all_month$" exists!
4780   LOCal a$,b$,res
4790   b$=""
4800   IF what_date
4810     a$=DATE$(what_date)         : REMark make date passed as param into string
4820   ELSE
4830     a$=DATE$                    : REMark current date into string
4840   END IF
4850   b$=a$(6 TO 8)                 : REMark 3 letter month abbreviation
4860   res= b$ INSTR all_months$             : REMark find it
4870   IF NOT res
4880        all_months$=make_all_months$     : REMark not found?, make all_month$
4890        res= b$ INSTR all_months$        : REMark and retry
4900   END IF
4910   res=(res+2)/3                 : REMark this is the month in figures
4920   b$=res:IF res<10:b$="0"&b$            : REMark add leading 0 if necessary
4930   IF dflag%:RETurn a$(10 TO 11)&"."&b$&"."&a$(1 TO 4)
4940   RETurn a$(1 TO 4)&"."&b$&"."&a$(10 TO 11)
4950 END DEFine make_date$
