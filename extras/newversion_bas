4140 DEFine PROCedure fbackup (source$,dest$)
4150 REMark makes a forced backup, eventually deleting newer files on dest
4160 REMark and replacing them with the files on source$
4170 REMark fbackup "dir_with_new_files", "dir_with_old_files"
4180 LOCal chan%,lp%,myfile$,a$,t%,tc%,len_old,len_new,date_old,date_new,b$,mdir$,mdest$
4190   FOR lp%=1 TO 50
4200     myfile$="ram8_diffs_txt"&RND(1 TO 80)&RND (1 TO 80) & RND (1 TO 50)
4210     chan%=FOP_NEW (myfile$)            : REMark try to open unique file
4220     IF chan%>0:EXIT lp%
4230   END FOR lp%
4240   IF source$(LEN(source$))<>"_":source$=source$&"_"
4250   IF dest$(LEN(dest$))<>"_":dest$=dest$&"_"
4260   PRINT#ichan%, 'source= ';source$
4270   PRINT#ichan%, "dest= ";dest$
4280   mdir$=source$(1 TO 5)
4290   mdest$=dest$(1 TO 5)
4300   IF chan%<0:RETurn                     : REMark ooops!!!!
4310   WDIR#chan%,source$                    : REMark dir of this rep in file
4320   GET#chan%\0                           : REMark reset file pointer to start
4330   REPeat lp%
4340     IF EOF(#chan%):EXIT lp%
4350     INPUT#chan%,a$                      : REMark get filename
4360     IF a$="":NEXT lp%
4370     t%= ' ->' INSTR a$                  : REMark is it a subdir?
4380     IF t%
4390       tc%=LEN(source$)-4
4400       c$=a$(tc% TO)
4410       c$=c$(TO LEN(c$)-3)&"_"
4420       fbackup mdir$&a$(TO LEN(a$)-3)&'_',dest$&c$
4430       NEXT lp%
4440     END IF
4450     tc%=FOP_IN(mdir$&a$)                : REMark open source file
4460     date_old=FUPDT(#tc%)                : REMark file date of "old" source file
4470     CLOSE#tc%
4480     tc%=LEN(source$)-4                  : REMark length of name w/o subdirectory
4490     b$=a$(tc% TO)
4500     DELETE dest$&b$
4510     COPY mdir$&a$,dest$&b$
4520     tc%=FOPEN(dest$&b$)
4530     SET_FUPDT#tc%,date_old
4540     CLOSE#tc%
4550   END REPeat lp%
4560   CLOSE#chan%
4570   DELETE myfile$
4580 END DEFine fbackup
