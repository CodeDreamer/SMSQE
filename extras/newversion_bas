3050     front$=front$(1 TO t%-1)&smsq_vers$&front$(t%+13 TO)
3060   END IF
3070   t%="xxxsmsqexxx" INSTR front$
3080   IF t%
3090     front$=front$(1 TO t%-1)&svers$&"/smsqe"&svers$&front$(t%+11 TO)
3100   END IF
3110   t%="xxxsubdirxxx" INSTR front$
3120   IF t%
3130     front$=front$(1 TO t%-1)&svers$&"/"&front$(t%+12 TO)
3140   END IF
3150   t%="xxxdatexxx" INSTR front$
3160   IF t%
3170     front$=front$(1 TO t%-1)&today$&front$(t%+10 TO)
3180   END IF
3190   t%="xxxsversxxx" INSTR front$
3200   IF t%
3210     front$=front$(1 TO t%-1)&svers$&front$(t%+11 TO)
