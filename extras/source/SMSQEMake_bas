18650 def proc do_popup2(string$,main_defn)
18660 rem This pops up a small "hint" window showing the string$ passed
18670 rem as parameter.
18680 rem main_defn is the working defintion of the window over which the hint
18690 rem window is to hover. Position the pointer there where you need it before
18700 rem calling this.
18710 rem If the string is too long to fit into the window (which can only be as long
18720 rem as the outline of the working defn) then the string is split up at the
18730 rem first convenient space and put on a second line, and so on.
18740 rem If this would lead to the hint window being too high, only as many
18750 rem lines as possible will be displayed.
18760 rem !!!!!
18770 rem This presumes that a char is 10 pixels high & 6 pixels wide (standard ql 6x10 matrix)..
18780 rem !!!!!
18790 rem The string may contain the char chr$(10) - there will be a newline.
18800 rem
18810 rem note : do not try to pass a screen chaneel, open & close one here.
18820 rem
18830 local dummy%,lp%,address,con%,temp%,lastspace%,xs%,ys%,temp$
18840 local hint$(10),slen% ,maxlength%,popup_lfl%(0),popup_mfl%(0,0)
18850   if string$="":return                            : rem empty string, do nothing
18860   strip_spaces string$                         : rem no spaces at ends
18870   con%=fopen("con")
18880   if main_defn<>0
18890     xs%=peek_w (main_defn+32)
18900     ys%=peek_w(main_defn+34)            : rem get max sizes the hint wdw may have
18910   else
18920     scr_size#con%,xs%,ys%
18930   endif
18940   xs%=(xs%-4) div 6                               : rem max nbr of chars in 1 line
18950   ys%=(ys%-4) div 10                              : rem max nbr of lines in wdw
18960   if xs%=0 or ys%=0:close#con%:return   : rem nothing will really fit, just leave
18970   dim hint$(ys%,xs%)                              : rem array to contain string
18980   rem now parse the string, find newlines, make sure of string length
18990   dummy%=1                                        : rem start of current string section
19000   temp%=0                                         : rem line
19010   slen%=0                                         : rem current length of string
19020   for lp%=1 to len(string$)
19030     if string$(lp%)=chr$(10)
19040       hint$(temp%)=string$(dummy% to lp%-1): rem cut string here
19050       temp%=temp%+1
19060       if temp%=ys%:exit lp%             : rem max nbr of lines reached
19070       dummy%=lp%+1                      : rem this is where new start of string is
19080       lastspace%=lp%
19090     else
19100       if string$(lp%)=" "
19110           lastspace%=lp%                          : rem this is where last space is
19120       endif
19130     endif
19140     slen%=slen%+1                       : rem one more char
19150     if slen% > xs%
19160       hint$(temp%)=string$(dummy% to lastspace%-1) : rem too many chars in line
19170       slen%=0
19180       temp%=temp%+1                               : rem we need nother line
19190       if temp%=ys%:exit lp%             : rem max nbr of lines reached
19200       dummy%=lastspace%+1
19210     endif
19220   end for lp%
19230   if temp%<ys%
19240      hint$(temp%)=string$(dummy% to)       : rem add last part
19250      temp%=temp%+1
19260   endif
19270   maxlength%=0
19280   for lp%=0 to temp%
19290     temp$= hint$(lp%)
19300     strip_spaces temp$                         : rem use intermediary var, because of QLIB
19310     if maxlength%<len(temp$):maxlength%=len (temp$)
19320   end for lp%
19330   lp%=(maxlength%*6)+4                            : rem hint window length
19340   poke_w popup_defn+32,lp%              : rem set window xsize
19350   poke_w popup_defn+34,temp%*10+2       : rem
19360   address=peek_l(popup_defn+112)        : rem ptr to app sub wdw...
19370   address=peek_l(address)               : rem ...now
19380   poke_w address,lp%-2                            : rem set its length
19390   poke_w address+2,temp%*10             : rem set its height
19400   dr_puld popup_defn,-1,-1,popup_lfl%,popup_mfl%
19410   dr_awdf#con%,popup_defn,0             : rem pull wdw over info wdw
19420   wm_paper#con%,sp.hintbg
19430   wm_ink#con%,sp.hintfg
19440   for lp%=0 to dimn(hint$,1)
19450     if hint$(lp%)<>"":temp$=hint$(lp%):strip_spaces temp$:print#con%,temp$
19460   end for lp%
19470   temp%=0:slen%=0:xs%=0:ys%=0:dummy%=0
19480   RD_PTR popup_defn,temp%,dummy%,slen%,xs%,ys%,popup_lfl%,popup_mfl%: rem comes back immediatley
19490   RD_PTR popup_defn,temp%,dummy%,slen%,xs%,ys%,popup_lfl%,popup_mfl%
19500   close#con%
19510   dr_unst popup_defn
19520 end def do_popup2
