15440 def fn mk_main_app (app_addr,subwinarray$,x_csize%,y_csize%, use_apm2%,hit_is_do%,sizex%,origx%)
15450 rem This makes a standard menu appsub with standard global variables.
15460 rem It presumes that the followng vars have been set:
15470 rem  * rows% holds the number of rows to be seen in the appsub window when there
15480 rem    are no scroll arrows (if there are, 1 less row will be seen)
15490 rem  * app_y_orig% = y origin of appsub within the main wdw
15500 rem  * xsize% = x size of main window (NOT subwindow)
15510 rem  * menu_selkeys$ holds the selkeys to exclude (string with upper cased keys)
15520 rem  *      set to "" if no selkeys wished, set to " " if no selkeys are excluded
15530 rem  * appw_sections% holds the nbr of sections to show
15540 rem  * main_cty% (DIMed here) is the  control sections array
15550 rem  * main_mfl% (DIMed here) is the menu items flag array
15560 rem
15570 rem Params:
15580 rem  * app_addr is the address of the appsub window, but 0 on first call
15590 rem  * subwinarry$ holds the data (2 dimensional string array)
15600 rem  * x, y_csize% are the csizes of objects in the appsub, standard values
15610 rem  * use_apm2% whether we use (=1) AP_MAKE2 or not (=0)
15620 rem  * hit_is_do% if hit should be = do
15630 rem  * sizex%= wished x size, leave at 0 if automatic size wished
15640 rem  * origx%= wished x orig, leave at 0 if automatic orig wished
15650 rem
15660 local temp%,selk%,app_attrs%(3,1),xs%,xo%
15670   if app_addr:rechp app_addr
15680   dim main_cty%(0):dim main_mfl%(0,0)
15690   temp%=x_csize%*16                               : rem x csize into upper nibble
15700   temp%=(temp%+y_csize%)*256            : rem y into lower, all into upper byte
15710   temp%=temp%+appw_sections%            : rem temp% is changed by the call to fen_app
15720   if menu_selkeys$=""
15730     selk%=0                                       : rem use no selkeys
15740   else
15750     selk%=1
15760   endif
15770   if hit_is_do%:selk%=selk%+256         : rem hit should be do
15780   if sizex%<1
15790     xs%=xsize%-16
15800   else
15810     xs%=sizex%
15820   endif
15830   if origx%<1
15840     xo%=0
15850   else
15860     xo%=origx%
15870   endif
15880   if use_apm2%
15890     app_addr=ap_make2(selk%,xs%,rows%,xo%,app_y_orig%,temp%,subwinarray$)
15900   else
15910     app_addr=ap_make(selk%,xs%,rows%,xo%,app_y_orig%,temp%,subwinarray$,menu_selkeys$&" ")
15920   endif                                 : rem on return temp%=nbr of objects
15930   IF app_addr = 0: RETurn 0             : rem  error, return 0
15940 :
15950   dim main_cty%(appw_sections%,2)       : rem control defn
15960   main_cty%(0,0)=1                      : rem at start show 1 section
15970   if temp%>rows%
15980     main_cty%(1,2)=rows%                : rem nbr of rows to show
15990   else
16000     main_cty%(1,2)=temp%                : rem there are less objects than rows
16010   endif
16020   main_cty%(1,2)=rows%
16030   if appw_sections%=2:main_cty%(2,2)=2
16040   if temp%
16050      dim main_mfl%(temp%-1,0)                     : rem flag array if there are any objects
16060   end if
16070   scroll_arrows rows%,temp%,app_addr,main_cty%
16080   return app_addr
16090 end define mk_main_app
